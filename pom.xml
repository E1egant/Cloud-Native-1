<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.rutaexpress</groupId>
    <artifactId>rutaexpress</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>rutaexpress</name>
    <description>Plataforma de envíos de última milla RutaExpress</description>

    <modules>
        <module>contracts</module>
        <module>ms-rutaexpress-shipments</module>
        <module>ms-rutaexpress-catalog</module>
        <module>ms-rutaexpress-notify</module>
        <module>ms-rutaexpress-report</module>
        <module>ms-rutaexpress-audit</module>
        <module>ms-rutaexpress-bff</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <rutaexpress-contracts.version>0.1.0-SNAPSHOT</rutaexpress-contracts.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.rutaexpress</groupId>
                <artifactId>rutaexpress-contracts</artifactId>
                <version>${rutaexpress-contracts.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
